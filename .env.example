# Port the relay listens on (host and container, default 7777).
PORT=7777

# Admin panel port, published on the host for internal/LAN access only
# (default 8080). Do not expose it through the tunnel or a public proxy.
# The admin account (username + password) is created on FIRST access to the
# panel - it is stored in the relay database, not in .env.
ADMIN_PORT=8080

# Cloudflare Tunnel token. Only needed when running the optional tunnel
# profile:  docker compose --profile tunnel up -d
# Two ways to set it:
#   1. Preferred: save it in the admin panel (Settings -> Cloudflare Tunnel).
#      The relay writes it to tunnel.env and it applies after:
#        docker compose restart cloudflared
#   2. Here in .env as a first-boot fallback.
# Create the tunnel in Cloudflare Zero Trust -> Networks -> Tunnels
# (connector type "Cloudflared") and set the public hostname (e.g.
# relay.daygle.net) with service type HTTP and URL "http://relay:7777".
# TUNNEL_TOKEN=
